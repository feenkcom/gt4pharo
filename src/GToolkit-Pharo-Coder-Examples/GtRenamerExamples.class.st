Class {
	#name : #GtRenamerExamples,
	#superclass : #Object,
	#category : #'GToolkit-Pharo-Coder-Examples'
}

{ #category : #'examples - instance variable' }
GtRenamerExamples >> applyInstanceVariableRename [
	"Renaming an instance variable is a real, system-wide RBRefactoring, unlike temporary-variable
	rename: pressing Return the first time only opens a refactoring preview (see
	GtCoderViewModelRenameAction>>#processReturnFor:in:); a second Return actually applies it."

	<gtExample>
	| scripter realClass originalName newName |
	scripter := self startInstanceVariableRename.
	realClass := (scripter userData at: #environment) anyDummyClass realClass.
	originalName := scripter userData at: #originalName.
	newName := originalName copyFrom: 1 to: originalName size - 1.

	scripter keyPressStep: [ :s | s key: BlKeyboardKey arrowLeft ].
	scripter keyPressStep: [ :s | s label: 'Delete char'; key: BlKeyboardKey backspace ].
	scripter keyPressStep: [ :s | s label: 'Open preview'; key: BlKeyboardKey return ].
	scripter keyPressStep: [ :s | s label: 'Apply rename'; key: BlKeyboardKey return ].

	self assert: (realClass instVarNames includes: newName).
	self assert: (realClass instVarNames includes: originalName) not.
	^ scripter
]

{ #category : #accessing }
GtRenamerExamples >> applyRename [
	<gtExample>
	| scripter |
	scripter := self startRename.
	
	scripter
		keyPressStep: [ :s | 
			s
				key: BlKeyboardKey arrowLeft ].
	
	scripter
		keyPressStep: [ :s | 
			s
				label: 'Delete char';
				key: BlKeyboardKey backspace ].

	scripter
		keyPressStep: [ :s | 
			s
				label: 'Apply rename';
				key: BlKeyboardKey return ].

	self
		assert: scripter element editor text asString
				equals: (self methodText copyReplaceAll: 'anInteger' with: 'anIntege').
	^ scripter
]

{ #category : #'examples - instance variable' }
GtRenamerExamples >> cancelInstanceVariableRename [
	<gtExample>
	| scripter realClass originalName |
	scripter := self startInstanceVariableRename.
	realClass := (scripter userData at: #environment) anyDummyClass realClass.
	originalName := scripter userData at: #originalName.

	scripter keyPressStep: [ :s | s label: 'Delete char'; key: BlKeyboardKey backspace ].
	scripter keyPressStep: [ :s | s label: 'Cancel rename'; key: BlKeyboardKey escape ].

	self assert: (realClass instVarNames includes: originalName).
	^ scripter
]

{ #category : #accessing }
GtRenamerExamples >> cancelRename [
	<gtExample>
	| scripter |
	scripter := self startRename.
	scripter
		keyPressStep: [ :s | 
			s
				label: 'Delete char';
				key: BlKeyboardKey backspace ].

	scripter
		keyPressStep: [ :s | 
			s
				label: 'Cancel rename';
				key: BlKeyboardKey escape ].

	self assert: scripter element editor text asString = self methodText.
	^ scripter
]

{ #category : #'examples - support' }
GtRenamerExamples >> cursorOffsetToLandInside: anIdentifierName ofText: aString [
	"Answer an arrowRight count that lands the cursor strictly inside the first occurrence of
	anIdentifierName within aString — any position inside its character range is enough for the
	inline-rename shortcut to find the right AST node."

	<return: #Integer>
	^ (aString indexOfSubCollection: anIdentifierName) - 1 + (anIdentifierName size // 2)
]

{ #category : #'examples - support' }
GtRenamerExamples >> dummyClassForRenameExamples [
	"Answer a fresh disposable environment holding one class with an instance variable (already
	auto-generated by the dummy generator), a class variable, and no compiled methods yet —
	callers add whatever method they need to exercise. The environment's #removeFromSystem
	(triggered by GC, or explicitly) removes the whole dummy package, so a class-rename
	test that changes the class's own name is still cleaned up correctly."

	<return: #GtPharoDummyEnvironment>
	| environment realClass |
	environment := GtPharoDummyEnvironment withPackages: 1 classes: 1.
	realClass := environment anyDummyClass realClass.
	realClass addClassVarNamed: #ClassVarOne.
	^ environment
]

{ #category : #'examples - instance variable' }
GtRenamerExamples >> instanceVariableRenamerScripter [
	<gtExample>
	| environment realClass instVarName text editorElement scripter |
	environment := self dummyClassForRenameExamples.
	realClass := environment anyDummyClass realClass.
	instVarName := realClass instVarNames first.

	text := 'readInstanceVariable
	^ ' , instVarName.

	GtPharoCodeModifier current
		compileMethodSource: text
		in: realClass
		protocol: 'accessing'.

	editorElement := GtSourceCoderElement new
		textualCoderViewModel: (GtPharoMethodCoderViewModel new coder: (GtPharoMethodCoder forClass: realClass source: text asRopedText));
		fitContent.

	scripter := BlScripter new.
	scripter element: editorElement.
	scripter userData at: #environment put: environment.
	scripter userData at: #originalName put: instVarName.
	^ scripter
]

{ #category : #examples }
GtRenamerExamples >> methodText [
	^ 'double: anInteger
	^ anInteger + anInteger'
]

{ #category : #examples }
GtRenamerExamples >> scripter [
	<gtExample>
	
	^ BlScripter new
]

{ #category : #examples }
GtRenamerExamples >> smalltalkRenamer [
	<gtExample>
	| text editorElement |

	text := self methodText asRopedText.

	editorElement := GtSourceCoderElement new
		textualCoderViewModel: (GtPharoMethodCoderViewModel new coder: (GtPharoMethodCoder forClass: self class source: text));
		fitContent.

	^ editorElement
]

{ #category : #accessing }
GtRenamerExamples >> smalltalkRenamerScripter [
	<gtExample>
	| scripter |
	scripter := self scripter.
	scripter element: self smalltalkRenamer.
	^ scripter
]

{ #category : #'examples - instance variable' }
GtRenamerExamples >> startInstanceVariableRename [
	<gtExample>
	| scripter offset |
	scripter := self instanceVariableRenamerScripter.
	offset := self
		cursorOffsetToLandInside: (scripter userData at: #originalName)
		ofText: scripter element editor text asString.

	scripter requestFocus onSelf; play.
	scripter substep: 'Move cursor' do: [ :aStep | offset timesRepeat: [ (aStep keyPress: BlKeyboardKey arrowRight) play ] ].
	scripter shortcut
		label: 'Start rename';
		combination: BlKeyCombination primaryR;
		// GtSourceCoderEditorInnerId;
		play.
	^ scripter
]

{ #category : #accessing }
GtRenamerExamples >> startRename [
	<gtExample>
	| scripter |
	scripter := self smalltalkRenamerScripter.

	scripter requestFocus
		onSelf;
		play.

	scripter
		substep: 'Move cursor'
		do: [ :aStep | 10 timesRepeat: [ (aStep keyPress: BlKeyboardKey arrowRight) play ] ].

	scripter shortcut
		label: 'Start rename';
		combination: BlKeyCombination primaryR;
		// GtSourceCoderEditorInnerId;
		play.

	^ scripter
]
